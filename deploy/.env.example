# Copy to .env (chmod 600). Never commit the real file.

# LiveKit (must match the key/secret in livekit.yaml)
LIVEKIT_API_KEY=YOUR_API_KEY
LIVEKIT_API_SECRET=YOUR_API_SECRET
LIVEKIT_WS_URL=wss://rtc.zienorganisation.online
LIVEKIT_HOST=127.0.0.1:7880
MAX_PARTICIPANTS=10

# Accounts: regular members allowed (admins don't count)
MAX_USERS=10

# Web app listens on localhost only; Caddy passes the real visitor IP via PROXY protocol v1
HOST=127.0.0.1
PROXY_PROTOCOL=1

# Email verification via Resend (free tier: 3,000/month, 100/day).
# Set the key with: sudo ./set-resend-key.sh
MAIL_FROM=Zien Call <no-reply@zienorganisation.online>
RESEND_API_KEY=
